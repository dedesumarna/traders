<script>
// ============================================================
// HERO - INTERACTIVE ELEMENTS
// ============================================================
(function() {
  'use strict';

  // 1. Parallax Effect pada Floating Badge (saat scroll)
  var floatingBadges = document.querySelectorAll('.floating-badge');
  var phoneMockup = document.querySelector('.phone-mockup');

  if (phoneMockup) {
    window.addEventListener('scroll', function() {
      var scrolled = window.pageYOffset;
      var heroHeight = document.querySelector('.hero').offsetHeight;

      if (scrolled < heroHeight) {
        var translate = scrolled * 0.1;

        floatingBadges.forEach(function(badge, index) {
          var direction = index % 2 === 0 ? 1 : -1;
          badge.style.transform = 'translateY(' + (translate * direction) + 'px)';
        });

        // Phone subtle parallax
        if (scrolled < heroHeight / 2) {
          phoneMockup.style.transform = 'rotate(-3deg) translateY(' + (translate * 0.05) + 'px)';
        }
      }
    });
  }

  // 2. Animated Counter (kalau nanti pakai angka di stats)
  function animateCounter(element, target, duration) {
    var start = 0;
    var increment = target / (duration / 16);
    var current = start;

    var timer = setInterval(function() {
      current += increment;
      if (current >= target) {
        element.textContent = formatNumber(target);
        clearInterval(timer);
      } else {
        element.textContent = formatNumber(Math.floor(current));
      }
    }, 16);
  }

  function formatNumber(num) {
    if (num >= 1000000) {
      return (num / 1000000).toFixed(1) + 'M';
    }
    if (num >= 1000) {
      return (num / 1000).toFixed(0) + 'K';
    }
    return num.toString();
  }

  // 3. Smooth Scroll untuk semua anchor link
  document.querySelectorAll('a[href^="#"]').forEach(function(anchor) {
    anchor.addEventListener('click', function(e) {
      var targetId = this.getAttribute('href');
      if (targetId === '#') return;

      var target = document.querySelector(targetId);
      if (target) {
        e.preventDefault();
        var headerOffset = 80;
        var targetPosition = target.getBoundingClientRect().top + window.pageYOffset - headerOffset;

        window.scrollTo({
          top: targetPosition,
          behavior: 'smooth'
        });
      }
    });
  });

  // 4. Fade-in animation saat hero muncul (page load)
  var heroContent = document.querySelector('.hero-content');
  var heroVisual = document.querySelector('.hero-visual');

  if (heroContent && heroVisual) {
    heroContent.style.opacity = '0';
    heroContent.style.transform = 'translateY(30px)';
    heroContent.style.transition = 'opacity 0.8s ease, transform 0.8s ease';

    heroVisual.style.opacity = '0';
    heroVisual.style.transform = 'translateY(30px)';
    heroVisual.style.transition = 'opacity 0.8s ease, transform 0.8s ease';

    setTimeout(function() {
      heroContent.style.opacity = '1';
      heroContent.style.transform = 'translateY(0)';

      setTimeout(function() {
        heroVisual.style.opacity = '1';
        heroVisual.style.transform = 'translateY(0)';
      }, 150);
    }, 100);
  }

  console.log('Hero Section loaded.');
})();
</script>
