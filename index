<!DOCTYPE html>
<html>
<head>
<style>
/* ============================================================
   SECTION 1: HERO
   ============================================================ */
.hero {
  position: relative;
  min-height: 100vh;
  padding: 120px 24px 80px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #0A1628;
  overflow: hidden;
  isolation: isolate;
}

/* ---------- BACKGROUND ---------- */
.hero-bg {
  position: absolute;
  inset: 0;
  background-image: url('https://img.freepik.com/free-vector/dark-gradient-background-with-copy-space_53876-99548.jpg');
  background-size: cover;
  background-position: center;
  opacity: 0.4;
  z-index: 0;
  filter: saturate(0.8);
}

.hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, 
    rgba(10, 22, 40, 0.95) 0%, 
    rgba(10, 22, 40, 0.75) 50%,
    rgba(10, 22, 40, 0.95) 100%);
  z-index: 1;
}

/* ---------- GLOW EFFECTS ---------- */
.hero-glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(120px);
  z-index: 1;
  pointer-events: none;
}

.hero-glow-1 {
  width: 500px;
  height: 500px;
  background: rgba(245, 197, 66, 0.15);
  top: -100px;
  right: -100px;
}

.hero-glow-2 {
  width: 400px;
  height: 400px;
  background: rgba(22, 163, 74, 0.1);
  bottom: -100px;
  left: -100px;
}

/* ---------- CONTAINER ---------- */
.hero-container {
  position: relative;
  z-index: 2;
  max-width: 1280px;
  width: 100%;
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 60px;
  align-items: center;
}

/* ---------- KOLOM KIRI: CONTENT ---------- */
.hero-content {
  color: #F1F5F9;
}

/* Badge kecil di atas */
.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 16px;
  background: rgba(245, 197, 66, 0.08);
  border: 1px solid rgba(245, 197, 66, 0.25);
  border-radius: 100px;
  color: #F5C542;
  font-family: 'Montserrat', sans-serif;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  margin-bottom: 24px;
}

.hero-badge-dot {
  display: inline-block;
  width: 8px;
  height: 8px;
  background: #16A34A;
  border-radius: 50%;
  box-shadow: 0 0 12px rgba(22, 163, 74, 0.8);
  animation: pulse-dot 2s infinite;
}

@keyframes pulse-dot {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.6; transform: scale(0.85); }
}

/* Judul Utama */
.hero-title {
  font-family: 'Montserrat', sans-serif;
  font-weight: 800;
  font-size: clamp(32px, 5vw, 56px);
  line-height: 1.15;
  letter-spacing: -0.02em;
  margin: 0 0 24px 0;
  color: #FFFFFF;
}

.hero-gold {
  color: #F5C542;
}

.hero-underline {
  position: relative;
  display: inline-block;
  color: #F5C542;
}

.hero-underline::after {
  content: '';
  position: absolute;
  bottom: -4px;
  left: 0;
  width: 100%;
  height: 4px;
  background: linear-gradient(90deg, #F5C542, #FFD966, #F5C542);
  border-radius: 2px;
  box-shadow: 0 0 20px rgba(245, 197, 66, 0.5);
}

/* Subtitle */
.hero-subtitle {
  font-family: 'Inter', 'Roboto', sans-serif;
  font-size: clamp(15px, 1.2vw, 17px);
  line-height: 1.7;
  color: #CBD5E1;
  margin: 0 0 36px 0;
  max-width: 580px;
}

.hero-subtitle strong {
  color: #F5C542;
  font-weight: 700;
}

/* CTA Buttons */
.hero-cta {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  margin-bottom: 36px;
}

.btn-hero {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 16px 28px;
  border-radius: 100px;
  font-family: 'Montserrat', sans-serif;
  font-size: 15px;
  font-weight: 700;
  text-decoration: none;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  cursor: pointer;
  border: 2px solid transparent;
  letter-spacing: 0.2px;
  line-height: 1.3;
}

.btn-hero svg {
  flex-shrink: 0;
}

/* Primary Button */
.btn-hero-primary {
  background: #F5C542;
  color: #0A1628;
  border-color: #F5C542;
  box-shadow: 0 8px 24px rgba(245, 197, 66, 0.25);
}

.btn-hero-primary:hover {
  background: #FFD966;
  border-color: #FFD966;
  transform: translateY(-3px);
  box-shadow: 0 14px 36px rgba(245, 197, 66, 0.4);
}

/* Outline Button */
.btn-hero-outline {
  background: rgba(255, 255, 255, 0.05);
  color: #F1F5F9;
  border-color: rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}

.btn-hero-outline:hover {
  background: rgba(245, 197, 66, 0.1);
  border-color: #F5C542;
  color: #F5C542;
  transform: translateY(-3px);
}

/* Trust Badges */
.hero-trust {
  display: flex;
  flex-wrap: wrap;
  gap: 12px 24px;
  padding-top: 28px;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
}

.trust-item {
  display: flex;
  align-items: center;
  gap: 8px;
  font-family: 'Inter', 'Roboto', sans-serif;
  font-size: 13px;
  font-weight: 500;
  color: #94A3B8;
}

.trust-item svg {
  color: #16A34A;
  flex-shrink: 0;
}

/* ---------- KOLOM KANAN: VISUAL ---------- */
.hero-visual {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 540px;
}

/* Phone Mockup */
.phone-mockup {
  position: relative;
  width: 280px;
  height: 560px;
  background: #1E293B;
  border-radius: 40px;
  padding: 12px;
  box-shadow: 
    0 30px 60px rgba(0, 0, 0, 0.5),
    0 0 0 2px rgba(245, 197, 66, 0.15),
    0 0 60px rgba(245, 197, 66, 0.15);
  transform: rotate(-3deg);
  transition: transform 0.5s ease;
  z-index: 3;
}

.phone-mockup:hover {
  transform: rotate(0deg) scale(1.02);
}

.phone-notch {
  position: absolute;
  top: 12px;
  left: 50%;
  transform: translateX(-50%);
  width: 100px;
  height: 24px;
  background: #0A1628;
  border-radius: 0 0 16px 16px;
  z-index: 4;
}

.phone-screen {
  width: 100%;
  height: 100%;
  background: #0A1628;
  border-radius: 30px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  padding: 40px 16px 16px;
  gap: 12px;
}

/* Screen Header */
.screen-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 12px;
  border: 1px solid rgba(255, 255, 255, 0.05);
}

.screen-pair {
  display: flex;
  align-items: center;
  gap: 8px;
}

.pair-symbol {
  font-family: 'JetBrains Mono', 'Roboto Mono', monospace;
  font-size: 14px;
  font-weight: 700;
  color: #F1F5F9;
}

.pair-timeframe {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  font-weight: 600;
  color: #F5C542;
  padding: 2px 6px;
  background: rgba(245, 197, 66, 0.15);
  border-radius: 4px;
}

.screen-price {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.price-value {
  font-family: 'JetBrains Mono', monospace;
  font-size: 14px;
  font-weight: 700;
  color: #F1F5F9;
}

.price-change {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  font-weight: 600;
  color: #16A34A;
}

/* Screen Chart */
.screen-chart {
  background: rgba(255, 255, 255, 0.02);
  border-radius: 12px;
  padding: 8px;
  border: 1px solid rgba(255, 255, 255, 0.05);
  height: 140px;
}

.screen-chart svg {
  width: 100%;
  height: 100%;
}

/* Screen Signal */
.screen-signal {
  background: rgba(255, 255, 255, 0.03);
  border-radius: 12px;
  padding: 12px;
  border: 1px solid rgba(245, 197, 66, 0.15);
}

.signal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}

.signal-badge {
  font-family: 'Montserrat', sans-serif;
  font-size: 10px;
  font-weight: 700;
  color: #0A1628;
  background: #16A34A;
  padding: 3px 8px;
  border-radius: 4px;
  letter-spacing: 0.5px;
}

.signal-time {
  font-family: 'Inter', sans-serif;
  font-size: 10px;
  color: #94A3B8;
}

.signal-detail {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-bottom: 10px;
}

.signal-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.signal-label {
  font-family: 'Inter', sans-serif;
  font-size: 11px;
  color: #94A3B8;
}

.signal-value {
  font-family: 'JetBrains Mono', monospace;
  font-size: 12px;
  font-weight: 700;
  color: #F1F5F9;
}

.signal-value.profit {
  color: #16A34A;
}

.signal-value.loss {
  color: #DC2626;
}

.signal-status {
  display: flex;
  align-items: center;
  gap: 6px;
  padding-top: 10px;
  border-top: 1px solid rgba(255, 255, 255, 0.06);
  font-family: 'Inter', sans-serif;
  font-size: 10px;
  color: #F5C542;
  font-weight: 600;
}

.status-dot {
  display: inline-block;
  width: 6px;
  height: 6px;
  background: #16A34A;
  border-radius: 50%;
  box-shadow: 0 0 8px rgba(22, 163, 74, 0.8);
  animation: pulse-dot 2s infinite;
}

/* ---------- FLOATING BADGES ---------- */
.floating-badge {
  position: absolute;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px 18px;
  background: #FFFFFF;
  border-radius: 16px;
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
  z-index: 5;
  animation: float-badge 3s ease-in-out infinite;
}

.badge-equity {
  top: 60px;
  right: 0;
  animation-delay: 0s;
}

.badge-winrate {
  bottom: 80px;
  left: 0;
  animation-delay: 1.5s;
}

@keyframes float-badge {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10px); }
}

.badge-icon {
  width: 40px;
  height: 40px;
  background: rgba(245, 197, 66, 0.15);
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #B8860B;
  flex-shrink: 0;
}

.badge-icon-green {
  background: rgba(22, 163, 74, 0.12);
  color: #16A34A;
}

.badge-text {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.badge-value {
  font-family: 'Montserrat', sans-serif;
  font-size: 18px;
  font-weight: 800;
  color: #0A1628;
  line-height: 1;
}

.badge-label {
  font-family: 'Inter', sans-serif;
  font-size: 11px;
  font-weight: 500;
  color: #64748B;
  white-space: nowrap;
}

/* ---------- SCROLL INDICATOR ---------- */
.scroll-indicator {
  position: absolute;
  bottom: 30px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  text-decoration: none;
  z-index: 3;
  transition: opacity 0.3s;
}

.scroll-indicator:hover {
  opacity: 0.7;
}

.scroll-text {
  font-family: 'Inter', sans-serif;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: #94A3B8;
}

.scroll-line {
  display: block;
  width: 2px;
  height: 30px;
  background: linear-gradient(180deg, #F5C542, transparent);
  border-radius: 2px;
  animation: scroll-line 1.8s ease-in-out infinite;
}

@keyframes scroll-line {
  0% { transform: scaleY(0); transform-origin: top; opacity: 0; }
  50% { transform: scaleY(1); transform-origin: top; opacity: 1; }
  100% { transform: scaleY(0); transform-origin: bottom; opacity: 0; }
}

/* ============================================================
   RESPONSIVE HERO
   ============================================================ */

/* Tablet */
@media screen and (max-width: 1024px) {
  .hero {
    padding: 100px 20px 60px;
  }

  .hero-container {
    grid-template-columns: 1fr;
    gap: 60px;
    text-align: center;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-subtitle {
    max-width: 100%;
  }

  .hero-cta {
    justify-content: center;
  }

  .hero-trust {
    justify-content: center;
    max-width: 100%;
  }

  .hero-visual {
    min-height: 480px;
  }

  .phone-mockup {
    transform: rotate(0deg);
    width: 260px;
    height: 520px;
  }

  .badge-equity {
    right: 10px;
    top: 40px;
  }

  .badge-winrate {
    left: 10px;
    bottom: 60px;
  }
}

/* Mobile */
@media screen and (max-width: 640px) {
  .hero {
    padding: 100px 16px 60px;
    min-height: auto;
  }

  .hero-container {
    gap: 40px;
  }

  .hero-title {
    font-size: 28px;
    line-height: 1.25;
  }

  .hero-subtitle {
    font-size: 15px;
    line-height: 1.65;
    margin-bottom: 28px;
  }

  .hero-badge {
    font-size: 10px;
    padding: 6px 12px;
    letter-spacing: 1px;
  }

  .hero-cta {
    flex-direction: column;
    width: 100%;
    gap: 10px;
  }

  .btn-hero {
    width: 100%;
    justify-content: center;
    padding: 15px 24px;
    font-size: 14px;
  }

  .hero-trust {
    flex-direction: column;
    gap: 10px;
    align-items: center;
    width: 100%;
  }

  .trust-item {
    font-size: 12px;
  }

  /* Visual */
  .hero-visual {
    min-height: 420px;
    margin-top: 20px;
  }

  .phone-mockup {
    width: 220px;
    height: 440px;
    padding: 8px;
    border-radius: 32px;
  }

  .phone-screen {
    padding: 36px 12px 12px;
    gap: 8px;
    border-radius: 24px;
  }

  .phone-notch {
    width: 80px;
    height: 18px;
  }

  .screen-chart {
    height: 100px;
  }

  .signal-badge {
    font-size: 9px;
    padding: 2px 6px;
  }

  .floating-badge {
    padding: 10px 12px;
    gap: 8px;
    border-radius: 12px;
  }

  .badge-equity {
    top: 20px;
    right: -10px;
  }

  .badge-winrate {
    bottom: 40px;
    left: -10px;
  }

  .badge-icon {
    width: 32px;
    height: 32px;
    border-radius: 8px;
  }

  .badge-icon svg {
    width: 16px;
    height: 16px;
  }

  .badge-value {
    font-size: 14px;
  }

  .badge-label {
    font-size: 9px;
  }

  .scroll-indicator {
    display: none;
  }
}

/* Extra Small Mobile */
@media screen and (max-width: 380px) {
  .hero-title {
    font-size: 24px;
  }

  .phone-mockup {
    width: 200px;
    height: 400px;
  }

  .badge-equity {
    right: -20px;
  }

  .badge-winrate {
    left: -20px;
  }
}
</style>
</head>
